{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monsquaz Swap",
  "version": "../package.json",
  "identifier": "org.monsquaz.swap",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monsquaz Swap",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Anonymous Discord music-swap host",
    "longDescription": "Host anonymous exquisite-corpse music swaps over Discord. The app runs the bot, stores the schedule and credits in SQLite, and keeps every file version organized on disk.",
    "copyright": "Copyright 2026 Patrik Weibull",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
